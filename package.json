{
  "name": "nfunc-mcp",
  "version": "0.3.0",
  "description": "MCP server for non-functional QA — Lighthouse, pa11y, ESLint and Semgrep in parallel with cross-tool correlation, plus PageSpeed Insights audits that compare lab scores against real-user Core Web Vitals from CrUX",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "nfunc-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && mkdir -p dist/config && cp src/config/*.js dist/config/",
    "start": "node dist/index.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "qa",
    "quality-assurance",
    "lighthouse",
    "pa11y",
    "accessibility",
    "wcag",
    "eslint",
    "semgrep",
    "performance",
    "non-functional-testing",
    "claude",
    "ai-tools",
    "pagespeed",
    "pagespeed-insights",
    "core-web-vitals",
    "crux",
    "psi",
    "web-vitals",
    "lcp",
    "cls",
    "inp"
  ],
  "author": "Ajinkya Kunjir",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hiddensound/NFunc_MCP.git"
  },
  "homepage": "https://github.com/Hiddensound/NFunc_MCP#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "execa": "^9.6.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3"
  }
}
